# Required for live checkout
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. If empty, PDFQuick creates lookup_key prices on first checkout.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=

# Signs the paid-plan cookie. Use a long random string in production.
SESSION_SECRET=

# Public site URL for Stripe redirects and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
